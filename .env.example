# Application
NODE_ENV=development
PORT=3000

# Frontend origin allowed by CORS (single origin). Required in production.
FE_URL=http://localhost:3000

# PostgreSQL connection string used by Prisma at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aether_ai?schema=public"

# JWT signing secret. REQUIRED - generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google OAuth - the OAuth 2.0 Client ID and Client Secret for server-side OAuth.
# Both are REQUIRED for Google sign-in and stay only on the backend (never the frontend).
# If unset, GET /auth/google/login returns 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Separate secret used to HMAC-sign the short-lived (120s) one-time Google login
# ticket that the redirect callback hands to the frontend. Generate like JWT_SECRET.
# Required for Google sign-in.
GOOGLE_TICKET_SECRET=

# After a successful Google sign-in the backend redirects the browser here.
# Defaults to FE_URL.
# GOOGLE_REDIRECT_PATH=/auth/callback

# Token lifetimes (ms-formatted strings, e.g. "15m", "7d")
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
